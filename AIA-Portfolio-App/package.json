{
  "name": "aia-powerbi-portfolio",
  "productName": "AIA PowerBI Portfolio",
  "version": "1.2.0",
  "description": "AIA Group PowerBI 作品集展示应用（本机联动项目目录，其他电脑自动用包内快照）",
  "main": "main.js",
  "author": "Jevon Zhu",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "start": "electron .",
    "sync:assets": "node scripts/sync-assets.js",
    "build": "npm run sync:assets && electron-builder --win portable"
  },
  "build": {
    "appId": "com.aia.portfolio",
    "files": [
      "main.js",
      "index.html",
      "icon-red.jpg",
      "lib/**/*",
      "*_report.html"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "AIA-PowerBI-Portfolio-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false
  }
}
